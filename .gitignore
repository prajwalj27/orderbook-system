# ── C++ Engine ────────────────────────────────────────────────
engine/build/
engine/results/
*.exe
*.o
*.a
*.dll

# ── Maven (gateway, consumer, client) ─────────────────────────
target/
*.class
*.jar

# ── Runtime data ───────────────────────────────────────────────
# WAL file — generated at runtime, not source code
gateway/data/
gateway/gateway/data/

# ── Credentials ────────────────────────────────────────────────
# application.properties may contain DB credentials — never commit real values.
# Each service has an application.properties.example with placeholder values.
*/src/main/resources/application.properties

# ── Python tests ───────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/

# ── IDE ────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
*.suo
*.user

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
